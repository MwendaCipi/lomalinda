# The deaconate's duty reminder: rung the day before the duty, every day.
# Installed by deploy.sh on the VPS; kept here for a box set up by hand.
# Adjust the project and virtualenv paths to match the deployment.
CRON_TZ=Africa/Nairobi
30 18 * * * cd /var/www/loma_linda/backend && /var/www/loma_linda/backend/venv/bin/python manage.py send_duty_reminders >> /var/log/loma_linda-duty-reminders.log 2>&1
